<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:mvc="http://www.springframework.org/schema/mvc"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans.xsd
                           http://www.springframework.org/schema/context
                           http://www.springframework.org/schema/context/spring-context.xsd
                           http://www.springframework.org/schema/mvc
                           http://www.springframework.org/schema/mvc/spring-mvc.xsd">

    <!-- 扫描 Controller 和 Config 包 -->
    <context:component-scan base-package="com.campus.lostfound.controller,com.campus.lostfound.config"/>

    <!-- 启用 Spring MVC 注解驱动 -->
    <mvc:annotation-driven>
        <mvc:message-converters>
            <!-- 配置 Jackson JSON 消息转换器 -->
            <bean class="org.springframework.http.converter.json.MappingJackson2HttpMessageConverter">
                <property name="objectMapper" ref="objectMapper"/>
                <property name="supportedMediaTypes">
                    <list>
                        <value>application/json;charset=UTF-8</value>
                        <value>text/html;charset=UTF-8</value>
                    </list>
                </property>
            </bean>
        </mvc:message-converters>
    </mvc:annotation-driven>

    <!-- 配置拦截器 -->
    <mvc:interceptors>
        <mvc:interceptor>
            <mvc:mapping path="/api/**"/>
            <mvc:exclude-mapping path="/api/user/login"/>
            <mvc:exclude-mapping path="/api/user/register"/>
            <mvc:exclude-mapping path="/api/item/list"/>
            <mvc:exclude-mapping path="/api/item/*"/>
            <mvc:exclude-mapping path="/api/item/*/similar"/>
            <ref bean="authInterceptor"/>
        </mvc:interceptor>
    </mvc:interceptors>

    <!-- 定义拦截器 Bean -->
    <bean id="authInterceptor" class="com.campus.lostfound.interceptor.AuthInterceptor"/>

    <!-- 静态资源处理 -->
    <mvc:default-servlet-handler/>

    <!-- 视图解析器（如果需要 JSP） -->
    <bean class="org.springframework.web.servlet.view.InternalResourceViewResolver">
        <property name="prefix" value="/WEB-INF/views/"/>
        <property name="suffix" value=".jsp"/>
    </bean>

</beans>
